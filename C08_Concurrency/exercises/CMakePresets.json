{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "CONCURRENCY_STUDY_BUILD_REFERENCE": "ON",
        "CONCURRENCY_STUDY_TEST_FAST_MATH": "OFF",
        "CONCURRENCY_STUDY_FETCH_DEPS": "OFF",
        "CONCURRENCY_STUDY_ENABLE_XSIMD": "OFF",
        "CONCURRENCY_STUDY_ENABLE_STDEXEC": "OFF",
        "CONCURRENCY_STUDY_ENABLE_CXX26": "OFF",
        "CONCURRENCY_STUDY_BUILD_BENCHMARKS": "OFF",
        "CONCURRENCY_STUDY_ENABLE_UNSAFE_DEMOS": "OFF",
        "CONCURRENCY_STUDY_SANITIZER": "none",
        "CONCURRENCY_STUDY_ENABLE_CXX29": "OFF",
        "CONCURRENCY_STUDY_ENABLE_SPDLOG": "OFF"
      }
    },
    {
      "name": "verify-core",
      "inherits": "base",
      "displayName": "Offline C++23 core and checked references"
    },
    {
      "name": "student",
      "inherits": "base",
      "cacheVariables": {
        "CONCURRENCY_STUDY_BUILD_REFERENCE": "OFF",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "bench",
      "inherits": "verify-core",
      "cacheVariables": {
        "CONCURRENCY_STUDY_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "full-windows",
      "inherits": "bench",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CONCURRENCY_STUDY_ENABLE_XSIMD": "ON",
        "CONCURRENCY_STUDY_ENABLE_STDEXEC": "ON",
        "CONCURRENCY_STUDY_TEST_FAST_MATH": "ON",
        "CONCURRENCY_STUDY_FETCH_DEPS": "ON"
      }
    },
    {
      "name": "native-cxx26",
      "inherits": "verify-core",
      "cacheVariables": {
        "CONCURRENCY_STUDY_ENABLE_CXX26": "ON"
      }
    },
    {
      "name": "vs2026",
      "inherits": "verify-core",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs2026",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "vs2022",
      "inherits": "verify-core",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs2022",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "default",
      "inherits": "verify-core",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "debug",
      "inherits": "verify-core",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja",
      "inherits": "verify-core",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja"
    },
    {
      "name": "ninja-debug",
      "inherits": "ninja",
      "binaryDir": "${sourceDir}/build-ninja-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "asan-windows",
      "inherits": "verify-core",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CONCURRENCY_STUDY_SANITIZER": "address"
      }
    },
    {
      "name": "linux-core",
      "inherits": "verify-core",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "linux-core",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-asan",
      "inherits": "linux-core",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CONCURRENCY_STUDY_SANITIZER": "address"
      }
    },
    {
      "name": "linux-tsan",
      "inherits": "linux-core",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CONCURRENCY_STUDY_SANITIZER": "thread"
      }
    },
    {
      "name": "native-cxx29",
      "inherits": "native-cxx26",
      "cacheVariables": {
        "CONCURRENCY_STUDY_ENABLE_CXX29": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "verify-core",
      "configurePreset": "verify-core",
      "configuration": "Release"
    },
    {
      "name": "student",
