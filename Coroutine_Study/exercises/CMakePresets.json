{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "COROUTINE_STUDY_BUILD_REFERENCE": "OFF",
        "COROUTINE_STUDY_FETCH_DEPS": "OFF",
        "COROUTINE_STUDY_ENABLE_STAGE3": "OFF",
        "COROUTINE_STUDY_ENABLE_STDEXEC": "OFF",
        "COROUTINE_STUDY_ENABLE_ASIO": "OFF",
        "COROUTINE_STUDY_ENABLE_CPPCORO": "OFF",
        "COROUTINE_STUDY_ENABLE_IO_URING": "OFF",
        "COROUTINE_STUDY_ENABLE_IOCP": "OFF",
        "COROUTINE_STUDY_ENABLE_FOLLY": "OFF",
        "COROUTINE_STUDY_ENABLE_COBALT": "OFF",
        "COROUTINE_STUDY_ENABLE_UNSAFE_DEMOS": "OFF",
        "COROUTINE_STUDY_TEST_STARTERS": "OFF"
      }
    },
    {
      "name": "student",
      "displayName": "Student core (no third-party deps)",
      "inherits": "base",
      "cacheVariables": { "COROUTINE_STUDY_TEST_STARTERS": "ON" }
    },
    {
      "name": "verify-core",
      "displayName": "Verify core + reference targets",
      "inherits": "base",
      "cacheVariables": { "COROUTINE_STUDY_BUILD_REFERENCE": "ON" }
    },
    {
      "name": "full-windows",
      "displayName": "Full Windows light deps",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "COROUTINE_STUDY_FETCH_DEPS": "ON",
        "COROUTINE_STUDY_ENABLE_STDEXEC": "ON",
        "COROUTINE_STUDY_ENABLE_ASIO": "ON",
        "COROUTINE_STUDY_ENABLE_CPPCORO": "ON",
        "COROUTINE_STUDY_ENABLE_IOCP": "ON"
        ,
        "COROUTINE_STUDY_BUILD_REFERENCE": "ON"
      }
    },
    {
      "name": "full-linux-light",
      "displayName": "Full Linux light deps",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "COROUTINE_STUDY_FETCH_DEPS": "ON",
        "COROUTINE_STUDY_ENABLE_STDEXEC": "ON",
        "COROUTINE_STUDY_ENABLE_ASIO": "ON",
        "COROUTINE_STUDY_ENABLE_CPPCORO": "ON",
        "COROUTINE_STUDY_ENABLE_IO_URING": "ON"
        ,
        "COROUTINE_STUDY_BUILD_REFERENCE": "ON"
      }
    },
    {
      "name": "heavy-folly-linux",
      "displayName": "Linux heavy Folly lane",
      "inherits": "full-linux-light",
      "cacheVariables": { "COROUTINE_STUDY_ENABLE_FOLLY": "ON" }
    },
    {
      "name": "heavy-cobalt-linux",
      "displayName": "Linux heavy Boost.Cobalt lane",
      "inherits": "full-linux-light",
      "cacheVariables": { "COROUTINE_STUDY_ENABLE_COBALT": "ON" }
    },
    {
      "name": "default",
      "displayName": "Compatibility: default -> student",
      "inherits": "student",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "debug",
      "displayName": "Compatibility: debug core",
      "inherits": "student",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ninja",
      "displayName": "Compatibility: Ninja core",
      "inherits": "student",
      "binaryDir": "${sourceDir}/build-ninja",
      "generator": "Ninja"
    },
    {
      "name": "ninja-debug",
      "displayName": "Compatibility: Ninja debug core",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build-ninja-debug",
      "generator": "Ninja"
    },
    {
      "name": "vs2026",
      "displayName": "Compatibility: Visual Studio 18 2026 core",
      "inherits": "student",
      "binaryDir": "${sourceDir}/build-vs2026",
      "generator": "Visual Studio 18 2026",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2022",
      "displayName": "Compatibility: Visual Studio 17 2022 core",
      "inherits": "student",
      "binaryDir": "${sourceDir}/build-vs2022",
      "generator": "Visual Studio 17 2022",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "student", "configurePreset": "student", "configuration": "Release" },
    { "name": "verify-core", "configurePreset": "verify-core", "configuration": "Release" },
    { "name": "full-windows", "configurePreset": "full-windows", "configuration": "Release" },
    { "name": "full-linux-light", "configurePreset": "full-linux-light" },
    { "name": "heavy-folly-linux", "configurePreset": "heavy-folly-linux" },
    { "name": "heavy-cobalt-linux", "configurePreset": "heavy-cobalt-linux" },
    { "name": "default", "configurePreset": "default", "configuration": "Release" },
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug" },
    { "name": "ninja", "configurePreset": "ninja", "configuration": "Release" },
    { "name": "ninja-debug", "configurePreset": "ninja-debug", "configuration": "Debug" },
    { "name": "vs2026", "configurePreset": "vs2026", "configuration": "Release" },
    { "name": "vs2022", "configurePreset": "vs2022", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "student", "configurePreset": "student", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "verify-core", "configurePreset": "verify-core", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
