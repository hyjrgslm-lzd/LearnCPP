{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "DATA_STUDY_BUILD_REFERENCE": "ON",
        "DATA_STUDY_TEST_STUDENTS": "OFF",
        "DATA_STUDY_ENABLE_ASAN": "OFF",
        "DATA_STUDY_ENABLE_FRONTIER": "OFF",
        "DATA_STUDY_ENABLE_ICU": "OFF",
        "DATA_STUDY_ENABLE_FORMAT_LIBS": "OFF"
      }
    },
    {
      "name": "verify-core",
      "inherits": "base"
    },
    {
      "name": "verify-debug",
      "inherits": "base"
    },
    {
      "name": "student",
      "inherits": "base",
      "cacheVariables": {
        "DATA_STUDY_BUILD_REFERENCE": "OFF",
        "DATA_STUDY_TEST_STUDENTS": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "cacheVariables": {
        "DATA_STUDY_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "frontier",
      "inherits": "base",
      "cacheVariables": {
        "DATA_STUDY_ENABLE_FRONTIER": "ON"
      }
    },
    {
      "name": "icu-release",
      "inherits": "base",
      "cacheVariables": {
        "DATA_STUDY_ENABLE_ICU": "ON"
      }
    },
    {
      "name": "icu-debug",
      "inherits": "base",
      "cacheVariables": {
        "DATA_STUDY_ENABLE_ICU": "ON"
      }
    },
    {
      "name": "format-libs",
      "inherits": "base",
      "cacheVariables": {
        "DATA_STUDY_ENABLE_FORMAT_LIBS": "ON",
        "DATA_STUDY_SPDLOG_BACKEND": "fmt"
      }
    },
    {
      "name": "format-libs-std",
      "inherits": "base",
      "cacheVariables": {
        "DATA_STUDY_ENABLE_FORMAT_LIBS": "ON",
        "DATA_STUDY_SPDLOG_BACKEND": "std"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "verify-core",
      "configurePreset": "verify-core",
      "configuration": "Release"
    },
    {
      "name": "verify-debug",
      "configurePreset": "verify-debug",
      "configuration": "Debug"
    },
    {
      "name": "student",
      "configurePreset": "student",
      "configuration": "Release"
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "frontier",
      "configurePreset": "frontier",
      "configuration": "Release"
    },
    {
      "name": "icu-release",
      "configurePreset": "icu-release",
      "configuration": "Release"
    },
    {
      "name": "icu-debug",
      "configurePreset": "icu-debug",
      "configuration": "Debug"
    },
    {
      "name": "format-libs",
      "configurePreset": "format-libs",
      "configuration": "Release"
    },
    {
      "name": "format-libs-std",
      "configurePreset": "format-libs-std",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "verify-core",
      "configurePreset": "verify-core",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "verify-debug",
      "configurePreset": "verify-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "student",
      "configurePreset": "student",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "RelWithDebInfo",
      "filter": {
        "include": {
          "label": "^(reference|observation|capability|allocation)$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "frontier",
      "configurePreset": "frontier",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "icu-release",
      "configurePreset": "icu-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "icu-debug",
      "configurePreset": "icu-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "format-libs",
      "configurePreset": "format-libs",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "format-libs-std",
      "configurePreset": "format-libs-std",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
