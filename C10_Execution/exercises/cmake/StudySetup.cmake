set(C10_LIBURING_ROOT "" CACHE PATH "Existing liburing 2.15 prefix with C07 source commit marker")
if(C10_STUDY_ENABLE_IO_URING)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        message(FATAL_ERROR "io_uring is a Linux backend")
    endif()
    if(NOT EXISTS "${C10_LIBURING_ROOT}/c07-source-commit.txt")
        message(FATAL_ERROR "Provide C10_LIBURING_ROOT with fixed liburing provenance; no installation is attempted")
    endif()
    file(READ "${C10_LIBURING_ROOT}/c07-source-commit.txt" uring_revision)
    string(STRIP "${uring_revision}" uring_revision)
    if(NOT uring_revision STREQUAL "d41bf9220ec39277ff235379e9089d9e0fd6c2a5")
        message(FATAL_ERROR "Unexpected liburing source revision: ${uring_revision}")
    endif()
    find_path(C10_LIBURING_INCLUDE liburing.h PATHS "${C10_LIBURING_ROOT}/include" NO_DEFAULT_PATH REQUIRED)
    find_library(C10_LIBURING_LIBRARY NAMES uring PATHS "${C10_LIBURING_ROOT}/lib" NO_DEFAULT_PATH REQUIRED)
    add_library(c10_liburing UNKNOWN IMPORTED GLOBAL)
    set_target_properties(c10_liburing PROPERTIES IMPORTED_LOCATION "${C10_LIBURING_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${C10_LIBURING_INCLUDE}"
        INTERFACE_COMPILE_DEFINITIONS "C07_HAS_LIBURING=1;C10_HAS_LIBURING=1")
endif()
set(C10_STUDY_STUDENT_ROOT "" CACHE PATH "Independent completion directory: root/unit/solution.hpp")
