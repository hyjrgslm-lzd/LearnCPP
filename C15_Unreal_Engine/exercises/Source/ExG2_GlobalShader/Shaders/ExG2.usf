// 文件: ExG2.usf  — 最小 compute shader 骨架
//
// 注意：不需要在此处声明 cbuffer 或 register。
// BEGIN_SHADER_PARAMETER_STRUCT 在 C++ 侧构建元数据后，
// shader 编译器会在本文件前自动注入以下代码（通过 r.DumpShaderDebugInfo=1 可见）：
//
//   cbuffer Parameters
//   {
//       uint ThreadCount;           // SHADER_PARAMETER(uint32, ThreadCount)
//   };
//   RWBuffer<uint> OutputBuffer : register(u0);  // SHADER_PARAMETER_UAV
//
// 直接在下方使用 ThreadCount 和 OutputBuffer 即可。

#include "/Engine/Public/Platform.ush"

