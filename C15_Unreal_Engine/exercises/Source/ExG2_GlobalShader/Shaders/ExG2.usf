// ══════════════════════════════════════════════════════

// 由 C++ 侧 SHADER_PARAMETER(uint32, ThreadCount) 自动注入，此处勿重复声明
// uint ThreadCount;
// 由 C++ 侧 SHADER_PARAMETER_UAV(RWBuffer<uint32>, OutputBuffer) 自动注入
// RWBuffer<uint> OutputBuffer;

